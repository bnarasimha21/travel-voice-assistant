# Copy to .env and fill in. Every value here is a default the app reads when
# .env and the process environment do not set it.

# cascade: speech to text, LLM and text to speech run as separate stages (default).
# s2s: a speech-to-speech realtime model (S2S_PROVIDER below) hears and answers directly.
PIPELINE=cascade

# LLM: any OpenAI-compatible chat completions endpoint that supports tool calling.
# Default: DigitalOcean serverless inference with a model access key.
# A DigitalOcean agent endpoint also works for plain chat (set TOOLS=none):
#   LLM_BASE_URL=https://<your-agent-id>.agents.do-ai.run/api/v1
#   LLM_EXTRA_QUERY=agent=true
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_MODEL=openai-gpt-5.6-luna
LLM_API_KEY=
LLM_EXTRA_QUERY=
LLM_TIMEOUT_S=30

# Travel tools the model can call: any of weather,flights,hotels, or none.
# Use none for an endpoint that ignores client tools (see README).
TOOLS=weather,flights,hotels
TOOL_TIMEOUT_S=8
MAX_TOOL_ROUNDS=4
# Say a short "let me check" line if a tool is still running after this long.
FILLER_AFTER_MS=300
# weather: open-meteo (free, no key) or fixture. flights, hotels: fixture or duffel.
WEATHER_PROVIDER=open-meteo
FLIGHTS_PROVIDER=fixture
HOTELS_PROVIDER=fixture
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
DUFFEL_API_KEY=
DUFFEL_BASE_URL=https://api.duffel.com

# Speech to text:
#   transformers    local Whisper through Hugging Face (STT_MODEL is a hub id;
#                   openai/whisper-tiny or openai/whisper-base.en run fine on a CPU)
#   faster-whisper  local Whisper through CTranslate2, faster on a CPU
#                   (STT_MODEL is tiny, tiny.en, base.en, small, ... or a hub id)
#   deepgram-flux   hosted streaming STT that also decides when you finished
#                   (needs DEEPGRAM_API_KEY; TURN_DETECTOR is then not used)
#   fake            tests
STT_BACKEND=transformers
STT_MODEL=openai/whisper-base.en
STT_DEVICE=auto
STT_LANGUAGE=en
STT_COMPUTE_TYPE=int8

DEEPGRAM_API_KEY=
DEEPGRAM_URL=wss://api.deepgram.com/v2/listen
DEEPGRAM_MODEL=flux-general-en
# Confidence needed to end a turn (0.5 to 0.9), and the silence after which it ends anyway.
DEEPGRAM_EOT_THRESHOLD=0.7
DEEPGRAM_EOT_TIMEOUT_MS=5000

# Text to speech: kokoro (local) or fake (tests).
# Download the two files into ./models (see README).
TTS_BACKEND=kokoro
TTS_MODEL_PATH=models/kokoro-v1.0.int8.onnx
TTS_VOICES_PATH=models/voices-v1.0.bin
TTS_VOICE=af_sarah
TTS_SPEED=1.0
TTS_LANG=en-us

# Voice activity detection: silero (default) or energy (tests, no download).
VAD_BACKEND=silero
VAD_THRESHOLD=0.5
SILENCE_MS=700
MIN_SPEECH_MS=250
MAX_TURN_S=30
# Turn detection: silence ends a turn after SILENCE_MS of pause; smart asks the
# Smart Turn v3 model (models/smart-turn-v3.2-cpu.onnx, see README) at a short
# pause and waits up to SMART_TURN_MAX_SILENCE_MS when you sound unfinished.
TURN_DETECTOR=silence
SMART_TURN_BACKEND=onnx
SMART_TURN_MODEL_PATH=models/smart-turn-v3.2-cpu.onnx
SMART_TURN_PAUSE_MS=200
SMART_TURN_MAX_SILENCE_MS=2000
SMART_TURN_THRESHOLD=0.5
# Talking over the agent stops it. Needs browser echo cancellation (on by default) or headphones.
BARGE_IN=true
BARGE_IN_MIN_SPEECH_MS=300

# Speech to speech (PIPELINE=s2s): openai or gemini. The same travel tools are
# offered to the realtime model; the local STT, LLM and TTS settings are unused.
S2S_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
# server_vad (pause based) or semantic_vad (the model judges if you finished)
OPENAI_REALTIME_TURN_DETECTION=semantic_vad
GEMINI_API_KEY=
GEMINI_LIVE_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore

# Per-turn latency log: one JSON line per turn (stage timings, TTFA). none disables it.
METRICS_LOG=logs/turns.jsonl

# Web server. TURN_SERVER: none, hf, cloudflare or twilio (for visitors on other networks).
SERVER_NAME=127.0.0.1
SERVER_PORT=7860
SHARE=false
TURN_SERVER=none
